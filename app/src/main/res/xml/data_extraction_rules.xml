<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ reads these rules and ignores backup_rules.xml (#383). Until now it was pointed at
  backup_rules.xml itself, whose <full-backup-content> root is the wrong format here.

  Google cloud backup takes the keyboard's own files and the user dictionary, but no settings:
  jetpref_datastore keeps every preference in one file, the provider keyring with its API keys, the
  proxy password and the KLIPY key among them, and a backup rule can only take or leave a whole file.

  A device-to-device transfer never leaves the user's hands, so it still carries the settings (API keys
  included), the keyboard's own files and the user dictionary.

  Never the dictation history, its audio or the clipboard, which are left out of both by not being
  listed.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="ime" />
        <include domain="database" path="floris_user_dictionary" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="jetpref_datastore" />
        <include domain="file" path="ime" />
        <include domain="database" path="floris_user_dictionary" />
    </device-transfer>
</data-extraction-rules>
